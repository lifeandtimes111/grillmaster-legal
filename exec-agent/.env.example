# ---------------------------------------------------------------------------
# exec-agent configuration.
# Copy to .env and fill in. NEVER commit the filled-in .env.
# ---------------------------------------------------------------------------

# --- Claude ---------------------------------------------------------------
# Either set an API key here, or leave it blank and run `claude login` once so
# the Agent SDK picks up your Claude subscription credentials.
ANTHROPIC_API_KEY=
# Model the assistant runs on.
EXEC_AGENT_MODEL=claude-opus-5

# --- Telegram (phone surface) ---------------------------------------------
# 1. Message @BotFather on Telegram, send /newbot, copy the token here.
# 2. Send your new bot any message, then run `npm run whoami` to get your chat id.
TELEGRAM_BOT_TOKEN=
# Only this chat id may talk to the agent. This is the whole access control
# story, so it must be set before the bot will answer anyone.
TELEGRAM_OWNER_CHAT_ID=

# --- Google (Gmail + Calendar) --------------------------------------------
# From a Google Cloud project with the Gmail and Calendar APIs enabled,
# OAuth client type "Desktop app". Then run `npm run auth:google` once.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App Store Connect (optional) -----------------------------------------
# App Store Connect > Users and Access > Integrations > App Store Connect API.
ASC_KEY_ID=
ASC_ISSUER_ID=
# Absolute path to the downloaded AuthKey_XXXXXXXX.p8 file.
ASC_PRIVATE_KEY_PATH=
# Your numeric vendor number, for sales reports.
ASC_VENDOR_NUMBER=

# --- Behaviour ------------------------------------------------------------
# IANA timezone used for scheduling and for how the agent talks about dates.
EXEC_AGENT_TIMEZONE=America/New_York
# Cron schedules (5-field, in the timezone above). Blank disables the routine.
CRON_MORNING_BRIEF=30 7 * * 1-5
CRON_INBOX_TRIAGE=0 12,17 * * 1-5
CRON_EVENING_REVIEW=0 21 * * 0-6
CRON_WEEKLY_RESEARCH=0 9 * * 1
